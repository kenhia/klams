[Unit]
Description=klams memory service
Documentation=https://github.com/kenhia/klams
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=klams
Group=klams
ExecStart=/usr/local/bin/klams-service
EnvironmentFile=/etc/klams/klams.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Sprint 009 (FR-005, SC-002): raise the fd cap above the host
# default so the connection-limits layer reaches its per-peer budget
# before the kernel does.
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/ai/klams/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
