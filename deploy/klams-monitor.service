[Unit]
Description=klams systemd unit monitor
Documentation=https://github.com/kenhia/klams
After=klams-service.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=klams
Group=klams
ExecStart=/usr/local/bin/klams-monitor
Environment=KLAMS_CONFIG=/etc/klams/monitor.toml
# The monitor now reads the live hostname from procfs (#56); this is only a
# fallback for the $HOSTNAME env path. systemd does not export $HOSTNAME on its
# own, so %H (the system hostname) keeps that fallback correct too.
Environment=HOSTNAME=%H
# kpidash dashboard reporting (optional, sprint 010 / T024) needs a Redis
# password in REDISCLI_AUTH before the [kpidash] section in monitor.toml can
# publish status cards. This unit supplies none on purpose: the shipped
# default has to start on a host that has no such file.
#
# On a homelab host the password arrives from the per-host secrets file
# through the drop-in klams-monitor.service.d/10-khomelab-secrets.conf, which
# install-systemd.sh installs when that file is present (sprint 051).
# Anywhere else, set [kpidash].password in monitor.toml or add your own
# drop-in naming an EnvironmentFile of your choosing. Never an inline
# Environment= value: that puts the secret in the unit text, which
# `systemctl cat` and `systemctl show` will print for any user who asks.
Restart=on-failure
RestartSec=5
StateDirectory=klams
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
