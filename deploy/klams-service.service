[Unit]
Description=klams memory service
Documentation=https://github.com/kenhia/klams
After=docker.service network-online.target
Wants=network-online.target docker.service

# Cap crash-looping: if start fails 10x within 5min (e.g. [backup]
# backup_dir on an unmounted NAS), stop retrying instead of flooding
# the journal. If backup_dir is a network mount, also add a drop-in:
#   RequiresMountsFor=/path/to/backup_dir
# so the service waits for the mount (use x-systemd.automount in fstab).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=klams
Group=klams
ExecStart=/usr/local/bin/klams-service
# Sprint 018 (WI #61): SIGHUP hot-reloads [[auth.tokens]] from the
# config without dropping in-flight requests — `systemctl reload`.
ExecReload=/bin/kill -HUP $MAINPID
Environment=KLAMS_CONFIG=/etc/klams/klams.toml
Restart=on-failure
RestartSec=15
StateDirectory=klams
StandardOutput=journal
StandardError=journal

# Sprint 009 (FR-005, SC-002): raise the fd cap above the host
# default so the connection-limits layer reaches its per-peer budget
# before the kernel does.
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Sprint 020: ProtectSystem=strict makes the whole FS read-only for the
# service; the backup dir must be granted back explicitly or every
# nightly run dies on the lockfile with EROFS (this silently broke
# backups from 2026-05-31, when the hardened unit shipped, until 020).
# Keep in sync with [backup].backup_dir in /etc/klams/klams.toml.
ReadWritePaths=/gratch/klams-backup
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
