[Unit]
Description=klams memory service
Documentation=https://github.com/kenhia/klams
After=docker.service network-online.target
Wants=network-online.target docker.service

# Cap crash-looping: if start fails 10x within 5min (e.g. [backup]
# backup_dir on an unmounted NAS), stop retrying instead of flooding
# the journal. If backup_dir is a network mount, also add a drop-in:
#   RequiresMountsFor=/path/to/backup_dir
# so the service waits for the mount (use x-systemd.automount in fstab).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=klams
Group=klams
ExecStart=/usr/local/bin/klams-service
# Sprint 018 (WI #61): SIGHUP hot-reloads [[auth.tokens]] from the
# config without dropping in-flight requests — `systemctl reload`.
ExecReload=/bin/kill -HUP $MAINPID
Environment=KLAMS_CONFIG=/etc/klams/klams.toml
Restart=on-failure
RestartSec=15
StateDirectory=klams
StandardOutput=journal
StandardError=journal

# Sprint 009 (FR-005, SC-002): raise the fd cap above the host
# default so the connection-limits layer reaches its per-peer budget
# before the kernel does.
LimitNOFILE=65536

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectSystem=strict makes the whole FS read-only for the service.
# If you enable [backup] in /etc/klams/klams.toml, grant the backup
# dir back via a DROP-IN — do not edit this unit. systemd refuses to
# start a unit whose ReadWritePaths is absent, so hardcoding a path
# here breaks every host that lacks it (sprint 034 #774; the path
# used to be baked in, and the unit only started on Ken's kubs0).
#
#   # /etc/systemd/system/klams-service.service.d/backup.conf
#   [Service]
#   ReadWritePaths=/path/to/backup_dir
#
# Sprint 020 context: without this grant every nightly run dies on the
# lockfile with EROFS. If backup_dir is a network mount, add
# RequiresMountsFor=/path/to/backup_dir in the same drop-in.
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
