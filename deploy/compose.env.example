# klams compose environment file.
#
# Copy to $KLAMS_ROOT/config/compose.env and edit. Loaded by:
#   docker compose --env-file $KLAMS_ROOT/config/compose.env up -d
#
# All paths under KLAMS_DATA_ROOT are bind-mounted into the
# corresponding service containers. KLAMS_ROOT is the parent of
# config/, data/, and logs/.

KLAMS_ROOT=/ai/klams
KLAMS_DATA_ROOT=/ai/klams/data

# --- Image tags (pinned; bump deliberately) ---
POSTGRES_IMAGE_TAG=16
QDRANT_IMAGE_TAG=v1.18.0
# Use a `cpu-*` tag for CPU-only hosts (default). For GPU hosts, use
# a CUDA tag (e.g. `1.5`) and include `deploy/docker-compose.gpu.yml`
# in the compose invocation.
TEI_IMAGE_TAG=cpu-1.7
TEI_MODEL_ID=BAAI/bge-small-en-v1.5

# --- Secrets ---
# POSTGRES_PASSWORD: rendered by scripts/provision-storage-root.sh.
POSTGRES_PASSWORD=changeme-rendered-by-provision-script

# --- BEARER_TOKEN_REF ---
# The bearer token used by klams-service lives in klams.toml under
# [auth].bearer_token. It is NOT exported here to avoid leaking it
# into container environments. The provision script renders both
# files with the same generated 32-byte hex token.
