# klams compose environment file.
#
# Copy to $KLAMS_ROOT/config/compose.env and edit. Loaded by:
#   docker compose --env-file $KLAMS_ROOT/config/compose.env up -d
#
# All paths under KLAMS_DATA_ROOT are bind-mounted into the
# corresponding service containers. KLAMS_ROOT is the parent of
# config/, data/, and logs/.

KLAMS_ROOT=/ai/klams
KLAMS_DATA_ROOT=/ai/klams/data

# --- Image tags (pinned; bump deliberately) ---
POSTGRES_IMAGE_TAG=16
QDRANT_IMAGE_TAG=v1.18.0
# GPU/CPU/OpenAI-compat decision tree: docs/install.md. For NVIDIA
# hosts, use the CUDA tag matching the card's compute capability (an
# RTX 4080 SUPER is 8.9 → `89-1.9`) and include
# `deploy/docker-compose.gpu.yml` in the compose invocation. For
# CPU-only hosts use `cpu-1.9` and the CPU model pair:
#   TEI_IMAGE_TAG=cpu-1.9
#   TEI_MODEL_ID=BAAI/bge-small-en-v1.5
# Stay on a cpu-1.8+ tag: the compose command passes
# `--auto-truncate false`, which pre-1.8 TEI rejects outright
# (`unexpected argument 'false'` crashloop — found by the sprint 035
# ksandbox first-install, which hit it on cpu-1.7).
# (then set [embeddings] model_id/vector_dim/max_input_tokens/
# query_prefix in klams.toml to match — install.md has the checklist).
TEI_IMAGE_TAG=89-1.9
TEI_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
# Sprint 030: second-stage reranker (cross-encoder), same TEI image.
# NOT the WI's Qwen3-Reranker — TEI cannot serve that arch yet
# (upstream PRs open); swap the id when a TEI release merges support.
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
PROMETHEUS_IMAGE_TAG=v2.55.0
GRAFANA_IMAGE_TAG=11.2.2

# Observability profile defaults (override in your rendered compose.env).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Secrets ---
# POSTGRES_PASSWORD: rendered by scripts/provision-storage-root.sh.
POSTGRES_PASSWORD=changeme-rendered-by-provision-script

# --- Bearer tokens ---
# Tokens live in klams.toml as [[auth.tokens]] grants (docs/auth.md);
# they are NOT exported here to avoid leaking them into container
# environments. The provision script generates and renders them.
