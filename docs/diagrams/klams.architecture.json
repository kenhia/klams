  "cards": [
    {
      "dot": "cyan",
      "title": "One Retrieval Pipeline",
      "items": [
        "MCP memory_search and REST /memory/search are shells over klams_core::retrieval",
        "Four rank lists — global ANN, curated stratum, lexical, Postgres FTS — fuse by weighted RRF",
        "Cross-encoder rerank is best-effort: any failure serves the un-reranked order"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundary",
      "items": [
        "Bearer tokens carry scope and author; every write is attributed",
        "MCP callers see only the PublicMemory projection, never raw records",
        "All bind 127.0.0.1 — service :7777, pg :5432, qdrant :6334, TEI :7070/:7071"
      ]
    },
    {
      "dot": "emerald",
      "title": "Non-Agentic Writers",
      "items": [
        "klams-scanner keeps the knowledge corpus in sync with configured roots",
        "klams-monitor turns systemd unit-state edges into events",
        "Both use the same attributed REST contract as agents, via klams-client"
      ]
    }
  ]
